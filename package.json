{
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/extension-js/examples.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "programs/*"
  ],
  "packageManager": "pnpm@10.28.0",
  "name": "extension-examples-workspace",
  "version": "1.0.0",
  "type": "module",
  "description": "Examples for Extension.js",
  "author": {
    "name": "Cezar Augusto",
    "email": "boss@cezaraugusto.net",
    "url": "https://cezaraugusto.com"
  },
  "scripts": {
    "extension": "extension",
    "test:content-workflows": "node scripts/install-contracts/verify-content-template-first-dev.mjs",
    "test:content-react": "node scripts/install-contracts/verify-content-template-first-dev.mjs --templates content-react",
    "test:content-frameworks": "node scripts/install-contracts/verify-content-template-first-dev.mjs --templates content-react,content-vue,content-svelte",
    "test:content-live:chromium": "playwright test --project=dev-live --grep \"content script|mounts its app into the page\"",
    "test:firefox-reload:rdp": "node scripts/checks/verify-firefox-reload-rdp.mjs",
    "test:html-context-regression": "playwright test --project=sidebar --project=action --project=newtab --project=special-folders",
    "test:reload-matrix": "node scripts/reload-matrix/run-matrix.mjs",
    "test:reload-matrix:smoke": "node scripts/reload-matrix/run-smoke.mjs",
    "test:reload-matrix:remote": "RELOAD_MATRIX_MODE=remote node scripts/reload-matrix/run-matrix.mjs",
    "generate": "node scripts/catalog/generate-templates-meta.mjs",
    "generate:raw": "node scripts/catalog/generate-templates-meta.mjs --overwrite-staged",
    "catalog:readmes": "node scripts/catalog/update-template-readmes.mjs",
    "catalog:standardize": "node scripts/catalog/standardize-templates.mjs",
    "build:examples": "node scripts/build/build-all.mjs",
    "artifacts:package": "node scripts/catalog/package-artifacts.mjs",
    "artifacts:stage": "node scripts/catalog/publish-artifacts.mjs",
    "artifacts:prepare": "pnpm run build:examples && pnpm run artifacts:package && pnpm run generate:raw && pnpm run artifacts:stage",
    "pretest": "node -e \"const fs=require('fs'); if (!process.env.SKIP_BUILD && !fs.existsSync('examples/content/dist/chrome')) { require('child_process').execSync('pnpm run build:examples', {stdio: 'inherit'}); }\"",
    "ci": "node scripts/build/normalize-examples.mjs && pnpm run build:examples && pnpm test",
    "test": "playwright test",
    "test:ci": "pnpm lint",
    "test:all": "pnpm lint && pnpm test",
    "test:watch": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:install": "playwright install",
    "test:banner": "node scripts/checks/test-browser-banner.mjs",
    "test:gecko-surfaces": "node scripts/checks/assert-gecko-sidebar-surfaces.mjs",
    "test:canary-one-run": "node scripts/install-contracts/assert-canary-one-run-builds.mjs",
    "test:canary-runtime-installed": "node scripts/install-contracts/assert-canary-runtime-installed.mjs",
    "test:optional-deps-contract": "node scripts/install-contracts/assert-optional-deps-canary-matrix.mjs",
    "test:stable-install-modes": "node scripts/install-contracts/assert-stable-install-modes.mjs",
    "test:create-dev-workflow": "node scripts/install-contracts/assert-create-dev-workflow.mjs",
    "test:create-dev-workflow:all-templates": "node scripts/install-contracts/assert-create-dev-workflow.mjs",
    "test:stable-pnpm-postcss-repro": "node scripts/install-contracts/assert-stable-pnpm-postcss-repro.mjs",
    "test:pnpm-monorepo-dev": "node scripts/install-contracts/assert-strict-linker-dev.mjs --linker=pnpm-monorepo",
    "test:yarn-pnp-dev": "node scripts/install-contracts/assert-strict-linker-dev.mjs --linker=yarn-pnp",
    "test:optional-deps-contract-all": "pnpm run test:canary-one-run && pnpm run test:stable-install-modes -- --pm all && pnpm run test:create-dev-workflow && pnpm run test:stable-pnpm-postcss-repro",
    "test:coverage": "playwright test --reporter=html --reporter=json --reporter=junit",
    "test:content": "playwright test --project=content",
    "test:sidebar": "playwright test --project=sidebar",
    "test:action": "playwright test --project=action",
    "test:newtab": "playwright test --project=newtab",
    "test:special": "playwright test --project=special-folders",
    "test:mixed": "playwright test --project=mixed-context",
    "test:other": "playwright test --project=other",
    "test:assets": "playwright test --project=assets",
    "test:create": "playwright test --project=create",
    "test:multi-browser": "playwright test --project=multi-browser",
    "test:reload": "playwright test --project=reload",
    "test:firefox": "playwright test --project=firefox",
    "postinstall": "node -e \"if (!process.env.CI) { require('child_process').execSync('playwright install --with-deps', {stdio: 'inherit'}); }\"",
    "prepublishOnly": "pnpm run artifacts:prepare",
    "format": "prettier --write \"**/*.{ts,tsx,md,js,mjs,json}\"",
    "lint": "eslint .",
    "lint-staged": "lint-staged",
    "install:all": "pnpm install && pnpm -r install",
    "clean": "pnpm -r exec rm -rf dist build .extension node_modules/.cache",
    "test:browser-manifest": "node scripts/checks/assert-browser-manifest-integrity.mjs",
    "test:browser-manifest:all": "node scripts/checks/assert-browser-manifest-integrity.mjs --all",
    "test:safari-manifest": "node scripts/checks/assert-browser-manifest-integrity.mjs --targets=safari",
    "test:strict-json": "node scripts/checks/assert-strict-json.mjs",
    "test:catalog-readme": "node scripts/checks/assert-catalog-readme.mjs",
    "test:spec-coverage": "node scripts/checks/assert-spec-coverage.mjs",
    "test:public-folder": "node scripts/checks/assert-public-folder-location.mjs",
    "test:markup-punctuation": "node scripts/checks/assert-no-space-before-punctuation.mjs",
    "test:template-videos": "node scripts/checks/assert-template-videos.mjs",
    "test:template-screenshots": "node scripts/checks/assert-template-screenshots.mjs"
  },
  "files": [
    "templates-meta.json",
    "templates-meta.d.ts"
  ],
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@babel/eslint-parser": "8.0.5",
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.56.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.1",
    "eslint": "^9.16.0",
    "extension": "4.1.25-canary.1789771240.9b4be6a5",
    "globals": "^15.13.0",
    "knip": "^5.33.0",
    "lint-staged": "16.1.0",
    "prettier": "^3.4.2",
    "typescript": "7.0.2"
  }
}

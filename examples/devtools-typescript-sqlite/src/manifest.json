{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "version": "1.0.0",
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "devtools-typescript-sqlite@extension.js",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "name": "SQLite Request DevTools Panel Example",
  "description": "Records the inspected page's network requests in SQLite and lets you query them.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  },
  "chromium:content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'"
  },
  "firefox:content_security_policy": "script-src 'self' 'wasm-unsafe-eval'",
  "devtools_page": "devtools/index.html"
}
